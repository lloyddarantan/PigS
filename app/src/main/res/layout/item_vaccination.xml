<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_schedule_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Syringe Icon -->

    <TextView
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="💉"
        android:textSize="27sp"/>

    <!-- Vaccine Information -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tag 003, Pen 1, 15 Jun"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvVaccine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="[PCV2 Vaccine]"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Status and Button -->

    <LinearLayout
        android:layout_width="105dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Today"
            android:textColor="#FF5158"
            android:textSize="14sp"
            android:textStyle="bold"/>


        <Button
            android:id="@+id/btnAdminister"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_button"
            android:text="Administer"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:padding="0dp" />


    </LinearLayout>

</LinearLayout>