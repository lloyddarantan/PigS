<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="15dp">

            <!-- Back Button -->

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="◀ Back"
                android:textColor="#FF565D"
                android:textSize="16sp"/>

            <!-- PigSensor Logo -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:gravity="center"
                android:orientation="vertical">

<!--                <TextView-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="🐷"-->
<!--                    android:textSize="35sp"/>-->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PigSensor"
                    android:textColor="#F6B5B8"
                    android:textSize="35sp"
                    android:fontFamily="serif"
                    android:textStyle="normal"/>

            </LinearLayout>

            <!-- Search Bar -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#FF6268"
                    android:textSize="36sp"/>

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search Pig #"
                    android:singleLine="true"
                    android:inputType="number"
                    android:textColor="#333333"
                    android:textColorHint="#FF777D"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="#FF6268"
                    android:textSize="27sp"/>

            </LinearLayout>

            <!-- Space -->

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"/>

            <!-- Herd Immunity Card -->

            <!-- Herd Immunity Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_score_card"
                android:orientation="vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Herd Immunity Score"
                        android:textColor="#111111"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvImmunityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculating..."
                        android:textColor="#777777"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.pigs.view.ImmunityPieView
                        android:id="@+id/immunityPieView"
                        android:layout_width="115dp"
                        android:layout_height="115dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/tvImmunityPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="#000000"
                            android:textSize="27sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvImmunityCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading pig records..."
                            android:textColor="#444444"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/btnAddPig"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button"
                android:text="+ ADD PIG"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textAllCaps="false" />


            <Button
                android:id="@+id/btnScheduleVaccination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button"
                android:text="Schedule Vaccination"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold" />


            <!-- Upcoming Schedule Title -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Upcoming Vaccination Schedule"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Schedule List -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVaccinations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"/>

            <!-- Recent Log Chart Title -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:text="Recent Administered Log"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Recent Administered Log Table -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <TableLayout
                    android:id="@+id/tableVaccinationLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="#FFFFFF">

                    <!-- Table Header -->

                    <TableRow
                        android:background="#FFE5E5"
                        android:padding="10dp">

                        <TextView
                            android:text="Date"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:padding="8dp"/>

                        <TextView
                            android:text="Tag"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:padding="8dp"/>

                        <TextView
                            android:text="Vaccine Name"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:padding="8dp"/>

                        <TextView
                            android:text="Dose"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:padding="8dp"/>

                        <TextView
                            android:text="Staff ID"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:padding="8dp"/>

                    </TableRow>

                </TableLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>