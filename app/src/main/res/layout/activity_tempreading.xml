<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@color/pig_pink">


                <TextView
                    android:id="@+id/tvBack"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/white"
                    android:textSize="38sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperature Monitor"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live thermal readings"
                        android:textColor="#FFE7EF"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_search_bar">

                    <ImageView
                        android:id="@+id/ivSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_search"
                        android:contentDescription="Search"/>

                    <EditText
                        android:id="@+id/etSearchPig"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search Pig # or RFID tag..."
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>

                    <ImageView
                        android:id="@+id/ivScan"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_scan"
                        android:contentDescription="Scan RFID"/>

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <TextView
                            android:id="@+id/btnAll"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:gravity="center"
                            android:text="All"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_action_chip"/>



                        <TextView
                            android:id="@+id/btnNormal"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:gravity="center"
                            android:text="Normal"
                            android:textColor="@color/pig_pink"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_nav_pill"/>



                        <TextView
                            android:id="@+id/btnHigh"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:gravity="center"
                            android:text="High Risk"
                            android:textColor="@color/pig_pink"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_nav_pill"/>



                        <TextView
                            android:id="@+id/btnCritical"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:gravity="center"
                            android:text="Critical"
                            android:textColor="@color/pig_pink"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_nav_pill"/>

                    </LinearLayout>

                </HorizontalScrollView>



                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pig_pink"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_green">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9"
                            android:textColor="@color/pig_pink"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal"
                            android:textColor="@color/pig_pink"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_pink">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="#F28A00"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High"
                            android:textColor="#F28A00"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_pink">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="@color/pig_red"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Critical"
                            android:textColor="@color/pig_red"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pen A • Barn 1"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Updated 2 mins ago"
                        android:textColor="@color/pig_pink"
                        android:textSize="9sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPig003"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:background="@drawable/bg_card_pink">


                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="003"
                        android:textColor="@color/pig_red"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_red"/>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pig #003"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RFID: A-0034   ♙ Pig   14 mo"
                            android:textColor="@color/text_hint"
                            android:textSize="8sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠ Possible ASF symptom - flag for vet"
                            android:textColor="@color/pig_red"
                            android:textSize="8sp"/>

                    </LinearLayout>


                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="40.9°C"
                        android:textColor="@color/pig_red"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_red"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/cardPig011"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:background="@drawable/bg_card_pink">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="011"
                        android:textColor="#F28A00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_orange"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pig #011"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RFID: A-0112   ♙ Pig   9 mo"
                            android:textColor="@color/text_hint"
                            android:textSize="8sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitor closely · elevated"
                            android:textColor="#F28A00"
                            android:textSize="8sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="40.9°C"
                        android:textColor="#F28A00"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_orange"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPig001"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:background="@drawable/bg_card_green">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="001"
                        android:textColor="@color/pig_pink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_green"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pig #001"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RFID: A-0011   ♙ Pig   22 mo"
                            android:textColor="@color/text_hint"
                            android:textSize="8sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal range · Healthy"
                            android:textColor="#299642"
                            android:textSize="8sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="38.4°C"
                        android:textColor="#299642"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_green"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPig002"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:background="@drawable/bg_card_green">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="002"
                        android:textColor="@color/pig_pink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_green"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pig #002"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RFID: A-0022   ♙ Pig   18 mo"
                            android:textColor="@color/text_hint"
                            android:textSize="8sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal range · Healthy"
                            android:textColor="#299642"
                            android:textSize="8sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="38.7°C"
                        android:textColor="#299642"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_green"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/pig_pink"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● Normal (38–39.5 °C)"
                        android:textColor="#299642"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● High (39.6–40.5 °C)"
                        android:textColor="#F28A00"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● Critical (&gt;40.5 °C)"
                        android:textColor="@color/pig_red"
                        android:textSize="8sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:activeIndicatorLabelPadding="2dp"
        app:itemIconTint="#D3A8A8"
        app:itemPaddingTop="15dp"
        app:menu="@menu/botnav" />

</LinearLayout>
